    {
      "name": "Pet",
      "item": [
        {
          "name": "1. Add new pet (POST /pet)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 101,\n  \"category\": {\n    \"id\": 1,\n    \"name\": \"dogs\"\n  },\n  \"name\": \"Rex\",\n  \"photoUrls\": [\n    \"http://x/rex.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 1,\n      \"name\": \"friendly\"\n    }\n  ],\n  \"status\": \"available\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('id = 101', () => pm.expect(j.id).to.eql(101));",
                  "pm.test('name = Rex', () => pm.expect(j.name).to.eql('Rex'));",
                  "pm.test('status = available', () => pm.expect(j.status).to.eql('available'));",
                  "pm.collectionVariables.set('petId', j.id);"
                ]
              }
            }
          ]
        },
